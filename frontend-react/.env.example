# Frontend config template. Copy to `.env` for local use (.env is gitignored).
#
# Two groups below, and the difference matters:
#   • VITE_DEV_*        — used by vite.config.js, DEV ONLY. `vite build` discards
#                         the dev-server block entirely, so these never ship.
#   • VITE_API_BASE_URL — inlined into the production bundle at build time.
#
# Vite inlines VITE_* values during `npm run build` — they are NOT read at
# runtime. Setting them in a server's environment after the image is built has no
# effect; they must be present for the BUILD step (pass as a Docker build arg).

# ── Dev server only ──────────────────────────────────────────────────────────
# Where `npm run dev` forwards API calls (/ask, /auth, /conversations, /report,
# /reports). Point at your local FastAPI. Not a production setting.
VITE_DEV_API_TARGET=http://localhost:8000

# Vite dev server port (default 5173 if unset).
VITE_DEV_PORT=5173

# ── Shipped in the bundle ────────────────────────────────────────────────────
# Origin the BROWSER calls for the API, no trailing slash.
#
# Leave EMPTY for the normal deploy: requests stay relative ("/ask") and resolve
# against whatever origin served the page. FastAPI serves both the SPA and the
# API from one origin, so empty is correct and needs no per-environment config.
#
# NEVER set this to localhost — it is baked into the JS running in the user's
# browser, where "localhost" is THEIR machine, not your server.
#
# Set it ONLY for a split-origin deploy (separate API domain / CDN-hosted
# frontend). The backend must then also allow that origin via CORS.
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
