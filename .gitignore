__pycache__/
*.py[cod]
*.log

# Virtual envs
venv/
.venv/

# Local environment / secrets
# Covers backend/.env and frontend-react/.env — these hold real values and must
# never be committed. The .example templates ARE committed, so re-include them.
.env
.env.*
!.env.example

# Data files
*.xlsx

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/
.windsurf/
.claude/

# Runtime caches
.report_cache/

# Node / frontend build output (the image builds dist/ itself — see backend/Dockerfile)
node_modules/
frontend-react/dist/
