# Copy into Dokploy -> your app -> Environment (or `cp .env.example .env` locally).
# .env is gitignored and NOT shipped in the image — the deploy environment must
# carry these values itself.

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_HAIKU_MODEL=claude-haiku-4-6

# ── Analytics DB (LLM-facing, READ-ONLY) ─────────────────────────────────────
# The database generated SQL runs against. Use a read-only Postgres role.
DATABASE_URL=postgresql://user:pass@host:5432/V2_inventory_management

# ── App DB (users / conversations / reports) — read-write, NOT LLM-facing ─────
# If omitted, it is derived from DATABASE_URL by swapping in APP_DB_NAME
# (default: stacklogix_reportgeneration). Set it explicitly in production.
APP_DATABASE_URL=postgresql://user:pass@host:5432/stacklogix_reportgeneration

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# JWT_SECRET signs every session token (HS256). MUST be a long random value —
# if it is guessable, anyone can forge a token for any user. Rotating it logs
# every user out.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# How long a login stays valid, in days.
JWT_EXPIRY_DAYS=7

# ── Dokploy / compose ────────────────────────────────────────────────────────
# Nothing to set here: the domain is attached in the Dokploy UI (Compose ->
# Domains -> service `frontend`, container port 80), and the internal ports
# (nginx 80, uvicorn 7860) plus BACKEND_ORIGIN are fixed in docker-compose.yml.

# ── Frontend, DEV ONLY ───────────────────────────────────────────────────────
# Where `npm run dev` proxies API calls. Discarded by `vite build`, so it has no
# effect in production (FastAPI serves the SPA and API from one origin).
VITE_DEV_API_TARGET=http://localhost:8000
